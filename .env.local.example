# Copy this file to .env.local and fill in your Supabase project values.
# Find these in: Supabase dashboard → Project Settings → API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# SERVER-SIDE ONLY — never prefix with VITE_ or use in client-side code.
# Add to Netlify env vars as a secret; only reference in Netlify Functions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
